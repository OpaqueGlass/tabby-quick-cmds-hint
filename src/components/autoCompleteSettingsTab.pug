h3(translate='ogac.settings.general')

.form-line
    .header
        .title(translate='ogac.settings.use_regexp_prompt')
        .description(translate='ogac.settings.use_regexp_prompt_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.useRegExpDetectPrompt',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.settings.auto_init')
        .description(translate='ogac.settings.auto_init_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.autoInit',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.settings.enable_on_startup')
        .description(translate='ogac.settings.enable_on_startup_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.enableCompleteWithCompleteStart',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.settings.menu_show_item_max')
        .description(translate='ogac.settings.menu_show_item_max_desc')
    input.form-control(
        type='number',
        min=2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.menuShowItemMaxCount',
        (ngModelChange)='config.save()',
    )


h3(translate='ogac.ai.title')

.form-line
    .header
        .title(translate='ogac.ai.openai_base_url')
        .description(translate='ogac.ai.openai_base_url') 
    input.form-control(
        type='text',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIBaseUrl',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.ai.openai_key')
        .description(translate='ogac.ai.openai_key_desc')
    input.form-control(
        type='password',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIKey',
        (ngModelChange)='config.save()',
    )


.form-line
    .header
        .title(translate='ogac.ai.openai_model')
        .description(translate='ogac.ai.openai_model') 
    input.form-control(
        type='text',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIModel',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.ai.test_title')
        .description(translate='ogac.ai.test_connection_desc')
    button.btn.btn-outline-secondary.btn-sm(
        type='button',
        [disabled]='testingConnection',
        (click)='testConnection()',
    ) {{testingConnection ? t("ogac.ai.testing") : t("ogac.ai.test")}}

.og-ac-test-result(
    *ngIf='connectionTestResult != null',
    [class.text-success]='connectionTestResult.ok',
    [class.text-danger]='!connectionTestResult.ok',
) {{connectionTestResult.text}}


.alert.alert-warning(*ngIf='!isAutoMode() && aiConfig?.includeLastOutput')
    div(translate='ogac.ai.output_manual_only_hint')

.form-line
    .header
        .title(translate='ogac.ai.enable')
        .description(translate='ogac.ai.enable_desc')
    select.form-control(
        [(ngModel)]='aiConfig.enable',
        (ngModelChange)='config.save()',
    )
        option(value='off', translate='ogac.ai.mode_off')
        option(value='manual', translate='ogac.ai.mode_manual')
        option(value='auto', translate='ogac.ai.mode_auto')

ng-container(*ngIf='isAutoMode()')
    .form-line
        .header
            .title(translate='ogac.ai.inline_min_length')
            .description(translate='ogac.ai.inline_min_length_desc')
        input.form-control(
            type='number',
            min=1,
            [(ngModel)]='aiConfig.inlineMinLength',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate='ogac.ai.inline_debounce')
            .description(translate='ogac.ai.inline_debounce_desc')
        input.form-control(
            type='number',
            min=0,
            step=100,
            [(ngModel)]='aiConfig.inlineDebounce',
            (ngModelChange)='config.save()',
        )

.form-line
    .header
        .title(translate='ogac.ai.inline_max_count')
        .description(translate='ogac.ai.inline_max_count_desc')
    input.form-control(
        type='number',
        min=1,
        [(ngModel)]='aiConfig.inlineMaxCount',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.ai.timeout')
        .description(translate='ogac.ai.timeout_desc')
    input.form-control(
        type='number',
        min=1000,
        step=1000,
        [(ngModel)]='aiConfig.timeout',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.ai.include_cwd')
        .description(translate='ogac.ai.include_cwd_desc')
    toggle(
        [(ngModel)]='aiConfig.includeCwd',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.ai.include_last_output')
        .description(translate='ogac.ai.include_last_output_desc')
    toggle(
        [(ngModel)]='aiConfig.includeLastOutput',
        (ngModelChange)='config.save()',
    )

.form-line(*ngIf='aiConfig.includeLastOutput')
    .header
        .title(translate='ogac.ai.recent_output_max_lines')
        .description(translate='ogac.ai.recent_output_max_lines_desc')
    input.form-control(
        type='number',
        min=1,
        max=200,
        [(ngModel)]='aiConfig.recentOutputMaxLines',
        (ngModelChange)='config.save()',
    )

.form-line(*ngIf='aiConfig.includeLastOutput')
    .header
        .title(translate='ogac.ai.recent_output_max_chars')
        .description(translate='ogac.ai.recent_output_max_chars_desc')
    input.form-control(
        type='number',
        min=200,
        max=20000,
        step=100,
        [(ngModel)]='aiConfig.recentOutputMaxChars',
        (ngModelChange)='config.save()',
    )

h4(translate='ogac.envTags.title')

.form-line
    .header
        .title(translate='ogac.envTags.title')
        .description(translate='ogac.envTags.desc')
    button.btn.btn-outline-secondary.btn-sm((click)='toggleEnvTags()', translate='ogac.envTags.toggle')

ng-container(*ngIf='showEnvTags')
    .og-ac-env-tag(*ngFor='let tag of getEnvTags(); let ti = index')
        .og-ac-tag-header
            button.btn.btn-outline-secondary.btn-sm.og-ac-tag-toggle(
                type='button',
                (click)='toggleTag(tag.id)',
                [attr.title]='t("ogac.envTags.toggle")',
            ) {{isTagExpanded(tag.id) ? '▾' : '▸'}}
            input.form-control.og-ac-tag-name(
                type='text',
                [(ngModel)]='tag.name',
                (ngModelChange)='onEnvTagChanged()',
            )
            .og-ac-tag-summary.text-muted.small(*ngIf='!isTagExpanded(tag.id)') {{getTagSummary(tag)}}
            button.btn.btn-outline-danger.btn-sm((click)='removeEnvTag(tag.id)') ×

        ng-container(*ngIf='isTagExpanded(tag.id)')
            .form-line
                .header
                    .title(translate='ogac.envTags.system_version')
                    .description(translate='ogac.envTags.system_version_desc')
                input.form-control(
                    type='text',
                    [(ngModel)]='tag.systemVersion',
                    (ngModelChange)='onEnvTagChanged()',
                )

            .form-line
                .header
                    .title(translate='ogac.envTags.custom_prompt')
                    .description(translate='ogac.envTags.custom_prompt_desc')
                textarea.form-control(
                    rows='3',
                    [(ngModel)]='tag.customPrompt',
                    (ngModelChange)='onEnvTagChanged()',
                )

            .form-line
                .header
                    .title(translate='ogac.envTags.bind_profiles')
                    .description(translate='ogac.envTags.bind_profiles_desc')
                input.form-control.og-ac-profile-search(
                    type='text',
                    [placeholder]='t("ogac.envTags.search_profile")',
                    [(ngModel)]='profileSearchText[tag.id]',
                )
                .og-ac-profile-list
                    .og-ac-profile-row(*ngFor='let profile of getFilteredProfiles(tag)')
                        input(
                            type='checkbox',
                            [id]="'ogac-tag-' + tag.id + '-p-' + profile.id",
                            [checked]='isProfileInTag(tag, profile.id)',
                            (change)='toggleProfileInTag(tag, profile.id, $event)',
                        )
                        label(
                            [for]="'ogac-tag-' + tag.id + '-p-' + profile.id"
                        ) {{profile.name}}
                    .text-muted.small(*ngIf='getFilteredProfiles(tag).length === 0', translate='ogac.envTags.no_profile')

    .og-ac-tag-actions
        input.form-control.og-ac-tag-name(
            type='text',
            [(ngModel)]='newTagName',
            [placeholder]='t("ogac.envTags.new_tag_placeholder")',
        )
        button.btn.btn-outline-primary.btn-sm((click)='addEnvTag()', translate='ogac.envTags.add_tag')
        button.btn.btn-outline-secondary.btn-sm((click)='resetEnvTags()', translate='ogac.envTags.reset_tags')

h4(translate='ogac.promptTemplate.title')

.alert.alert-info
    div(translate='ogac.promptTemplate.desc')
    div
        code(*ngFor='let ph of getPlaceholders()') {{ph}}

.form-line
    .header
        .title(translate='ogac.promptTemplate.template')
    textarea.form-control.og-ac-template(
        rows='12',
        spellcheck='false',
        [(ngModel)]='aiConfig.promptTemplate',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.promptTemplate.preview')
        .description(translate='ogac.promptTemplate.preview_desc')
    input.form-control(
        type='text',
        [(ngModel)]='previewCmd',
    )
    select.form-control.mt-1(
        [(ngModel)]='previewProfileId',
    )
        option(value='', translate='ogac.promptTemplate.no_profile')
        option(*ngFor='let profile of getProfiles()', [value]='profile.id') {{profile.name}}
    pre.og-ac-preview {{getRenderedPromptPreview()}}
    .text-muted.small(*ngIf='getMissingPlaceholderKeys().length > 0')
        span(translate='ogac.promptTemplate.missing_hint')
        span {{' '}}
        code(*ngFor='let key of getMissingPlaceholderKeys()') {{key}}
    button.btn.btn-outline-secondary.btn-sm.mt-1((click)='resetPromptTemplate()', translate='ogac.promptTemplate.reset')


