h3(translate='ogac.settings.title')

.alert.alert-info.d-flex.align-items-center
    .me-auto
        div(translate="ogac.intro.tested_scenarios") 
            strong(translate='ogac.intro.ubuntu_centos') 
            span(translate='ogac.intro.or') 
            strong(translate='ogac.intro.centos') 
            span(translate='ogac.intro.via_ssh') 
            strong(translate='ogac.intro.ssh') 
            span(translate='ogac.intro.using_bash') 
            strong(translate='ogac.intro.bash') 
            span(translate='ogac.intro.on_windows') 
        div 
            p
                span(translate='ogac.intro.usage_instruction')
                code(translate='ogac.intro.tab_key') 
                span(translate='ogac.intro.tab_action') 
                code(translate='ogac.intro.enter_key') 
                span(translate='ogac.intro.enter_action')

.alert.alert-info.d-flex.align-items-center(*ngIf='!isQuickCmdsInstalled()')
    .me-auto
        div(translate='ogac.intro.plugin_requirement')

h3(translate='ogac.settings.general')

.form-line
    .header
        .title(translate='ogac.settings.use_regexp_prompt')
        .description(translate='ogac.settings.use_regexp_prompt_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.useRegExpDetectPrompt',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.settings.auto_init')
        .description(translate='ogac.settings.auto_init_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.autoInit',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.settings.enable_on_startup')
        .description(translate='ogac.settings.enable_on_startup_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.enableCompleteWithCompleteStart',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.settings.menu_show_item_max')
        .description(translate='ogac.settings.menu_show_item_max_desc')
    input.form-control(
        type='number',
        min=2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.menuShowItemMaxCount',
        (ngModelChange)='config.save()',
    )


h3(translate='ogac.ai.title')

.form-line
    .header
        .title(translate='ogac.ai.openai_base_url')
        .description(translate='ogac.ai.openai_base_url') 
    input.form-control(
        type='text',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIBaseUrl',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.ai.openai_key')
        .description(translate='ogac.ai.openai_key_desc')
    input.form-control(
        type='password',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIKey',
        (ngModelChange)='config.save()',
    )


.form-line
    .header
        .title(translate='ogac.ai.openai_model')
        .description(translate='ogac.ai.openai_model') 
    input.form-control(
        type='text',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIModel',
        (ngModelChange)='config.save()',
    )


h3(translate='ogac.appearance.title')

.form-line
    .header
        .title(translate='ogac.appearance.font_size')
    input.form-control(
        type='number',
        max=90,
        min=2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.appearance.fontSize',
        (ngModelChange)='config.save()',
    )


h3(translate='ogac.history.title')

.form-line(translate='ogac.history.manage_desc')

.form-line
    .header
        .title(translate='ogac.history.enable')
        .description(translate='ogac.history.enable_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.history.enable',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ogac.history.count_regexp')
        .description(translate='ogac.history.count_regexp_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.history.countInRegExp',
        (ngModelChange)='config.save()',
    )

h3(translate='ogac.arguments.title')

.form-line(translate='ogac.arguments.manage_desc')

.form-line
    .header
        .title(translate='ogac.arguments.enable')
        .description(translate='ogac.arguments.enable_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.arguments.enable',
        (ngModelChange)='config.save()',
    )

h3(translate='ogac.debug.title')

.form-line
    .header
        .title(translate='ogac.debug.enable_debug')
        .description(translate='ogac.debug.log_level_desc')
    input.form-control(
        type='number',
        max=4,
        min=-2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.debugLevel',
        (ngModelChange)='config.save()',
    )


.form-line 
    .header 
        .title(translate='ogac.debug.custom_regexp')
        .description(translate='ogac.debug.custom_regexp_desc')
textarea.form-control(
    rows='2',
    [(ngModel)]='config.store.ogAutoCompletePlugin.customRegExp',
    (ngModelChange)='config.save()'
)

.footer-of-setting
    div() 
        span(translate='ogac.support.give_star_prefix') 
        a.og-tac-a((click)='openGithub()',translate='ogac.support.give_star_link')
        span(translate='ogac.support.give_star_suffix')
    div()
        span(translate='ogac.support.issue_prefix') 
        a.og-tac-a((click)='openNewIssue()',translate='ogac.support.issue_link')
        span(translate='ogac.support.issue_suffix')
