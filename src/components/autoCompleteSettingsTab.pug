h3(translate='settings.title')

.alert.alert-info.d-flex.align-items-center
    .me-auto
        div(translate="intro.tested_scenarios") 
        strong(translate='intro.ubuntu_centos') 
        span(translate='intro.or') 
        strong(translate='intro.centos') 
        span(translate='intro.via_ssh') 
        strong(translate='intro.ssh') 
        span(translate='intro.using_bash') 
        strong(translate='intro.bash') 
        span(translate='intro.on_windows') 
        div 
            p(translate='intro.usage_instruction') 
            code(translate='intro.tab_key') 
            span(translate='intro.tab_action') 
            code(translate='intro.enter_key') 
            span(translate='intro.enter_action')

.alert.alert-info.d-flex.align-items-center(*ngIf='config.store["qc"] == undefined || config.store["qc"] == {}')
    .me-auto
        div(translate='intro.plugin_requirement')

h3(translate='settings.general')

.form-line
    .header
        .title(translate='settings.use_regexp_prompt')
        .description(translate='settings.use_regexp_prompt_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.useRegExpDetectPrompt',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='settings.auto_init')
        .description(translate='settings.auto_init_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.autoInit',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='settings.enable_on_startup')
        .description(translate='settings.enable_on_startup_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.enableCompleteWithCompleteStart',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='settings.menu_show_item_max')
        .description(translate='settings.menu_show_item_max_desc')
    input.form-control(
        type='number',
        min=2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.menuShowItemMaxCount',
        (ngModelChange)='config.save()',
    )


h3(translate='ai.title')

.form-line
    .header
        .title(translate='ai.openai_base_url')
        .description(translate='ai.openai_base_url') 
    input.form-control(
        type='text',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIBaseUrl',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='ai.openai_key')
        .description(translate='ai.openai_key_desc')
    input.form-control(
        type='password',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIKey',
        (ngModelChange)='config.save()',
    )


.form-line
    .header
        .title(translate='ai.openai_model')
        .description(translate='ai.openai_model') 
    input.form-control(
        type='text',
        [(ngModel)]='config.store.ogAutoCompletePlugin.ai.openAIModel',
        (ngModelChange)='config.save()',
    )


h3(translate='appearance.title')

.form-line
    .header
        .title(translate='appearance.font_size')
    input.form-control(
        type='number',
        max=90,
        min=2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.appearance.fontSize',
        (ngModelChange)='config.save()',
    )


h3(translate='history.title')

.form-line(translate='history.manage_desc')

.form-line
    .header
        .title(translate='history.enable')
        .description(translate='history.enable_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.history.enable',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate='history.count_regexp')
        .description(translate='history.count_regexp_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.history.countInRegExp',
        (ngModelChange)='config.save()',
    )

h3(translate='arguments.title')

.form-line(translate='arguments.manage_desc')

.form-line
    .header
        .title(translate='arguments.enable')
        .description(translate='arguments.enable_desc')
    toggle(
        [(ngModel)]='config.store.ogAutoCompletePlugin.arguments.enable',
        (ngModelChange)='config.save()',
    )

h3(translate='debug.title')

.form-line
    .header
        .title(translate='debug.enable_debug')
        .description(translate='debug.log_level_desc')
    input.form-control(
        type='number',
        max=4,
        min=-2,
        [(ngModel)]='config.store.ogAutoCompletePlugin.debugLevel',
        (ngModelChange)='config.save()',
    )


.form-line 
    .header 
        .title(translate='debug.custom_regexp')
        .description(translate='debug.custom_regexp_desc')
textarea.form-control(
    rows='2',
    [(ngModel)]='config.store.ogAutoCompletePlugin.customRegExp',
    (ngModelChange)='config.save()'
)

.footer-of-setting
    div() 
        span(translate='support.give_star_prefix') 
        a.og-tac-a((click)='openGithub()',translate='support.give_star_link')
        span(translate='support.give_star_suffix')
    div()
        span(translate='support.issue_prefix') 
        a.og-tac-a((click)='openNewIssue()',translate='support.issue_link')
        span(translate='support.issue_suffix')
